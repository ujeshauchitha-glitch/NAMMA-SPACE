{
  "name": "namma-space",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "quality": "python3 scripts/quality_gate.py",
    "test:watch": "vitest",
    "validate:scene": "python3 scripts/validate_scene.py public/scenes/fixture",
    "validate:scenes": "python3 scripts/validate_all_scenes.py public/scenes",
    "benchmark:build": "python3 scripts/benchmark_build.py",
    "preflight:reconstruction": "python3 scripts/reconstruct_colmap.py preflight",
    "reconstruct:colmap": "python3 scripts/reconstruct_colmap.py run"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "fflate": "0.8.3",
    "gsap": "3.15.0",
    "idb": "8.0.4",
    "playcanvas": "^2.6.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vite-plugin-mkcert": "2.1.0",
    "vitest": "^3.2.4"
  }
}
